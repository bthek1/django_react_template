# Single env file for the whole repo. Copy to `.env` in the repo root (`cp .env.example .env`).
# Read by Django (core/settings/base.py), Vite (envDir in frontend/vite.config.ts),
# docker-compose (env_file) and VS Code (.vscode/).
# Vite only exposes VITE_-prefixed vars to the browser bundle.

# --- Backend: Django ---
DJANGO_SETTINGS_MODULE=core.settings.dev
# 50+ random chars. PyJWT warns on HMAC keys under 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# docker-compose publishes Postgres on host port 5435 (5435:5432). Inside Docker
# Compose the service sets DATABASE_URL to @db:5432 itself.
# core/settings/dev.py falls back to localhost:5432 if this is unset.
DATABASE_URL=postgres://appuser:apppassword@localhost:5435/appdb

# Celery / Redis
# Host port is 6380 (docker-compose maps 6380:6379 to avoid clashing with a
# local Redis). Use redis://redis:6379/0 when running inside Docker Compose.
CELERY_BROKER_URL=redis://localhost:6380/0

# CORS: add the frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Email (override in prod)
DEFAULT_FROM_EMAIL=noreply@example.com

# Superuser (used by `just be-superuser`; email is the username field)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# --- Frontend: Vite ---
# URL of the Django API backend
VITE_API_BASE_URL=http://localhost:8005
